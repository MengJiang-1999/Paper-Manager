# Optional LLM Metadata Enrichment & BibTeX Audit Configuration
# Copy this file to .env or configure directly inside the app (Settings -> LLM Config)
LLM_ENABLED=false
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BIBTEX_PROMPT="Complete missing BibTeX fields (author, year, booktitle/journal, eprint, archivePrefix, doi, url) using the PDF first-page text. Always prefer the published conference/journal version (@inproceedings/@article) over an arXiv preprint (@misc): NEVER downgrade an existing @inproceedings/@article to @misc and NEVER delete existing booktitle/journal fields even if the PDF is an earlier arXiv preprint; if booktitle/journal has a publication year (e.g. ICML 2026), align year with it. Fix title typos, author format (\"First Last and First Last\"), and wrap title acronyms in {} (e.g. {LLM}). Output ONLY the corrected BibTeX."
