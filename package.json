{
  "name": "papermanager",
  "version": "1.0.0",
  "description": "PaperManager — 极简 macOS 学术论文管理器",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && bun run build:electron && electron .\"",
    "build:electron": "bun build electron/main.ts --outdir dist-electron --target node --format cjs --external electron --external pdfjs-dist && bun build electron/preload.ts --outdir dist-electron --target node --format cjs --external electron",
    "build": "vite build && bun run build:electron",
    "start": "bun run build && electron .",
    "pack:mac": "bun run build && electron-builder --mac dir --config.electronDist=node_modules/electron/dist",
    "dist:mac": "bun run build && electron-builder --mac dmg dir --config.electronDist=node_modules/electron/dist",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.papermanager.app",
    "productName": "PaperManager",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "dmg": {
      "title": "PaperManager"
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "wait-on": "^8.0.1"
  }
}
